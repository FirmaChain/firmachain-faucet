{
	"name": "firma-faucet",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"dependencies": {
		"@firmachain/firma-js": "0.3.7",
		"@mui/icons-material": "^6.1.6",
		"@mui/material": "^6.1.6",
		"@mui/styled-engine": "npm:@mui/styled-engine-sc@latest",
		"axios": "^1.15.0",
		"copy-to-clipboard": "^3.3.1",
		"immer": "^10.1.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-google-recaptcha": "^3.1.0",
		"react-json-tree": "^0.19.0",
		"styled-components": "^6.1.13",
		"zustand": "^5.0.1"
	},
	"devDependencies": {
		"@types/node": "^22.8.7",
		"@types/react-dom": "^18.3.1",
		"@types/react-google-recaptcha": "^2.1.9",
		"@vitejs/plugin-react-swc": "^3.10.2",
		"ajv": "^7.2.4",
		"path": "^0.12.7",
		"prettier": "^3.3.3",
		"typescript": "^4.9.5",
		"vite": "^7.0.4",
		"vite-plugin-bundle-obfuscator": "^1.7.0",
		"vite-plugin-node-polyfills": "^0.24.0",
		"vite-tsconfig-paths": "^5.1.4",
		"web-vitals": "^1.0.1"
	},
	"scripts": {
		"dev": "vite dev --mode dev",
		"testnet": "vite dev --mode testnet",
		"build": "vite build --mode testnet",
		"preview": "vite preview",
		"deploy": "aws s3 sync ./build s3://deploy-ecosystem/testnet/faucet --profile=firmachain-deploy --delete",
		"invalidate": "aws cloudfront create-invalidation --profile=firmachain-deploy --distribution-id E3KRC3IQXC40MN --paths '/*'",
		"format": "prettier --write \"src/**/*.{ts,tsx}\""
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"resolutions": {
		"@mui/styled-engine": "npm:@mui/styled-engine-sc@latest"
	},
	"packageManager": "yarn@4.9.2"
}
