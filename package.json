{
	"name": "firma-faucet",
	"version": "0.1.0",
	"private": true,
	"dependencies": {
		"@firmachain/firma-js": "^0.2.62",
		"@mui/icons-material": "^6.1.6",
		"@mui/material": "^6.1.6",
		"@mui/styled-engine-sc": "^6.1.6",
		"axios": "^1.7.7",
		"copy-to-clipboard": "^3.3.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-google-recaptcha": "^3.1.0",
		"react-json-tree": "^0.19.0",
		"react-scripts": "^5.0.1",
		"styled-components": "^6.1.13",
		"web-vitals": "^1.0.1",
		"zustand": "^5.0.1"
	},
	"scripts": {
		"start-testnet": "env-cmd -f .env.testnet craco start",
		"start-devnet": "env-cmd -f .env.devnet craco start",
		"build-testnet": "GENERATE_SOURCEMAP=false env-cmd -f .env.testnet craco build",
		"deploy-testnet": "aws s3 sync ./build s3://deploy-ecosystem/testnet/faucet --profile=firmachain-deploy --delete",
		"invalidate-testnet": "aws cloudfront create-invalidation --profile=firmachain-deploy --distribution-id E3KRC3IQXC40MN --paths '/*'",
		"format": "prettier --write \"src/**/*.{ts,tsx}\""
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"@babel/plugin-proposal-private-property-in-object": "^7.21.11",
		"@craco/craco": "^7.1.0",
		"@types/node": "^22.8.7",
		"@types/react-dom": "^18.3.1",
		"@types/react-google-recaptcha": "^2.1.9",
		"ajv": "^7.2.4",
		"browserify-fs": "^1.0.0",
		"env-cmd": "^10.1.0",
		"path": "^0.12.7",
		"prettier": "^3.3.3",
		"process": "^0.11.10",
		"stream-browserify": "^3.0.0",
		"typescript": "^4.9.5",
		"webpack": "^5.95.0"
	},
	"resolutions": {
		"@mui/styled-engine": "npm:@mui/styled-engine-sc@latest"
	}
}
